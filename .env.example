# Essential environment overrides

# Docker image version (used when the image line is active in docker-compose.yml)
IMAGE_VERSION=latest-develop

# Timezone (applies to synth, selenium-llm-engine, and db-backup containers)
TZ=Asia/Tokyo

# User/Group ID for file permissions inside containers (LinuxServer.io convention)
PUID=1000
PGID=1000

# Database configuration (keep these if you need to override defaults)
# The compose file and application provide sensible defaults; set these
# only when you need to connect to an external or custom database.
DB_HOST=synth-db                # Hostname of the database service (container name or IP)
DB_PORT=3306                    # Port for database service
DB_USER=synth                   # Database username
DB_PASS=synth                   # Database password
DB_NAME=synth                   # Database name
DB_ROOT_PASS=root               # Database root password (used when initializing MariaDB)
EXT_DB_PORT=3306                # External port exposed on the host for MariaDB

# Web Desktop / Selkies root credential (keep and change in production)
ROOT_PASSWORD=change_me         # Root password for the web desktop; change to a secure value

# Web UI ports
SYNTH_WEBUI_HTTPS_PORT=8000     # HTTPS port for the SyntH WebUI
SYNTH_WEBUI_HTTP_PORT=8080      # HTTP port for the SyntH WebUI

# Ollama-compatible endpoint port (SyntH can act as an OpenAI-compatible API)
OLLAMA_PORT=11435               # Default is standard Ollama port+1 to avoid conflicts

# More variables can be found in the wiki at https://synthetic-heart.readthedocs.io

