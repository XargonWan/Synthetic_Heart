# Synthetic Heart common deployment overrides.
#
# Copy this file to .env and uncomment only what you actually need.
# Everything here also works for a native (non-Docker) install; the sections
# marked [native] matter only outside a container.
# For the full list of low-frequency / advanced variables, see docs/compose_env_vars.rst.

# Docker image version (used when the image line is active in docker-compose.yml)
IMAGE_VERSION=latest-develop

# Timezone (applies to synth, zen-llm-engine, and db-backup containers)
TZ=Asia/Tokyo

# User/Group ID for file permissions inside containers (LinuxServer.io convention)
PUID=1000
PGID=1000

# ---------------------------------------------------------------------------
# Database configuration (PostgreSQL)
# ---------------------------------------------------------------------------
# The runtime is PostgreSQL. These values must match the database service; the
# compose stack defaults to 5432, so do NOT restore the historical 3306 default
# (that was the MariaDB port and it breaks the connection).
#
# A native install does not need to edit this block by hand: scripts/bootstrap.py
# creates the role, the database and the extensions, then writes these values.
DB_HOST=synth-db                # Hostname of the database service (container name or IP)
DB_PORT=5432                    # Port for the PostgreSQL service
DB_USER=synth                   # Database username
DB_PASS=synth                   # Database password
DB_NAME=synth                   # Database name
EXT_DB_PORT=5432                # External port exposed on the host for PostgreSQL

# ---------------------------------------------------------------------------
# [native] Host bindings
# ---------------------------------------------------------------------------
# Both listeners bind 0.0.0.0 by default, which is right inside a container and
# wrong on a desktop: on Windows it triggers the Defender "Allow access?" dialog
# and exposes the WebUI to the local network. A native install wants loopback.
# SYNTH_WEBUI_HOST=127.0.0.1
# OLLAMA_HOST=127.0.0.1

# ---------------------------------------------------------------------------
# [native] TLS
# ---------------------------------------------------------------------------
# Inside the container TLS is ON by default (SECURE_CONNECTION=1). A native
# install defaults to plain HTTP on loopback instead, so the first launch does
# not show a self-signed certificate warning. Set either variable to force it:
#   SYNTH_WEBUI_TLS=1  -> HTTPS with a certificate generated under the data root
#   SYNTH_WEBUI_TLS=0  -> plain HTTP (the native default)
# SYNTH_WEBUI_TLS=0

# ---------------------------------------------------------------------------
# [native] Container detection
# ---------------------------------------------------------------------------
# The Minecraft Vessel remaps 127.0.0.1 to host.docker.internal when it believes
# it runs inside a container. On a native install that name does not resolve, so
# set this explicitly to be safe.
# SYNTH_IN_CONTAINER=0

# ---------------------------------------------------------------------------
# LLM / provider credentials
# ---------------------------------------------------------------------------
# GEMINI_API_KEY=your_google_ai_studio_key
# OPENAI_API_KEY=your_openai_key
# OPENROUTER_API_KEY=your_openrouter_key
# ANTHROPIC_API_KEY=your_anthropic_key
# XAI_API_KEY=your_xai_key

# ---------------------------------------------------------------------------
# Ports
# ---------------------------------------------------------------------------
# Only set these when the defaults collide with something already running.
# scripts/bootstrap.py picks a free port automatically and writes it here.
SYNTH_WEBUI_HTTP_PORT=8080      # plain HTTP port for the WebUI
SYNTH_WEBUI_HTTPS_PORT=8000     # TLS port, used only when TLS is enabled
OPENAI_API_SERVER_PORT=11435    # OpenAI-compatible API (default Ollama port + 1)

# ---------------------------------------------------------------------------
# Trainer / notifications
# ---------------------------------------------------------------------------
# TRAINER_IDS=telegram_bot/123456789,discord_bot/my-guild/my-channel
# TRAINER_CHAT_ID=telegram_bot/123456789
# LOG_CHAT_INTERFACE=telegram_bot
# LOG_CHAT_ID=123456789

# ---------------------------------------------------------------------------
# WebUI / container basics
# ---------------------------------------------------------------------------
# IMAGE_VERSION=latest
# PUID=1000
# PGID=1000
# TZ=UTC
# ROOT_PASSWORD=change_me

# ---------------------------------------------------------------------------
# Primary database
# ---------------------------------------------------------------------------
# SYNTH_PRIMARY_DB selects which database holds the runtime data:
#   soul   -> the PostgreSQL database described by SOUL_* / SOUL_POSTGRES_DSN
#   memory -> the legacy MariaDB database described by DB_*
# Default is PostgreSQL. MariaDB is deprecated and kept only so an existing
# install can be migrated; a fresh install should never set SYNTH_PRIMARY_DB=memory.
# SYNTH_PRIMARY_DB=soul
# DB_HOST=synth-db
# DB_PORT=5432
# DB_USER=synth
# DB_PASS=synth
# DB_NAME=synth

# ---------------------------------------------------------------------------
# Legacy MariaDB source (migration only)
# ---------------------------------------------------------------------------
# Only needed when migrating an old MariaDB deployment into PostgreSQL. The
# installer never sets these; the compose stack keeps the legacy service behind
# the commented synth-legacy-db block.
# SOURCE_DB_TYPE=mariadb
# SOURCE_DB_HOST=synth-legacy-db
# SOURCE_DB_PORT=3306
# SOURCE_DB_USER=synth
# SOURCE_DB_PASSWORD=synth
# SOURCE_DB_NAME=synth
# EXECUTE_MARIADB_POSTGRES_MIGRATION=false

# ---------------------------------------------------------------------------
# Optional SOUL persistence
# ---------------------------------------------------------------------------
# SOUL_REPOSITORY_BACKEND=memory
# SOUL_POSTGRES_DSN=postgresql://synth:***@synth-db:5432/synth
# SOUL_PG_HOST=synth-db
# SOUL_PG_PORT=5432
# SOUL_PG_DB=synth
# SOUL_PG_USER=synth
# SOUL_PG_PASSWORD=synth
# EXT_SOUL_DB_PORT=5432

# ---------------------------------------------------------------------------
# Common behavior / defaults
# ---------------------------------------------------------------------------
# PROJECT_DEFAULT_LANGUAGE=en
# PROJECT_DEFAULT_TONE=balanced
# DIARY_HISTORY_DAYS=7
# GRILLO_BEAT_INTERVAL=900
# ENABLE_RECON=1
# ENABLE_DEBRIEF=1

# ---------------------------------------------------------------------------
# Optional observability
# ---------------------------------------------------------------------------
# LANGFUSE_ENABLED=0
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# CORTEX_API_LOG_ENABLED=1
# CORTEX_LANGFUSE_ENABLED=0
# LANGFUSE_FLUSH_EACH_CALL=0
# CORTEX_LANGFUSE_REDACT_PAYLOADS=1
# CORTEX_LANGFUSE_CAPTURE_HEADERS=0
# CORTEX_LANGFUSE_CAPTURE_GENERATIONS=1
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# SYNTH_VERSION=dev

# ---------------------------------------------------------------------------
# Weather / scheduled reporting
# ---------------------------------------------------------------------------
# WEATHER_FETCH_TIME=08:00
# WEATHER_DAILY_REPORT_ENABLED=0
# WEATHER_DAILY_REPORT_TIME=08:00
# WEATHER_DAILY_REPORT_LANGUAGE=en
# WEATHER_DAILY_REPORT_INTERFACE=telegram_bot/123456789

# ---------------------------------------------------------------------------
# Advanced storage / path / internal overrides
# ---------------------------------------------------------------------------
# Paths are resolved by core/app_paths.py: the container layout is used when it
# exists, otherwise everything falls back inside the application root, so a
# native install works without setting any of these.
# SYNTH_APP_ROOT=/opt/synth            # application root override
# SYNTH_DATA_ROOT=/var/lib/synth       # generated state (was the /config mount)
# SYNTH_LOG_DIR=/var/log/synth         # application logs
# XDG_DATA_HOME=/app/data
# SYNTH_SECRET_KEY=replace_me
# SYNTH_SECRET_FILE=/run/secrets/synth_secret_key
# SYNTH_ATTACHMENTS_ROOT=/app/data/attachments
# SYNTH_EXPOSED_STORAGE_ROOT=/app/data/exposed
# SYNTH_BACKUPS_DIR=/app/backups
# SYNTH_HOST_OS=linux
# SYNTH_VERSION=dev
# SYNTH_MATEENGINE_PROMOTE_ENABLED=1
# SYNTH_MATEENGINE_PROMPT_OVERRIDE=
# SYNTH_MATEENGINE_UPLOAD_CLEANUP_INTERVAL_S=3600
# SYNTH_MATEENGINE_UPLOAD_TTL_DAYS=7

