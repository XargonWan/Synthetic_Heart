{
  "servers": {
    "gemini-api-docs-mcp": {
      "type": "http",
      "url": "https://gemini-api-docs-mcp.dev"
    },
    "gitnexus": {
      "type": "stdio",
      "command": "npx",
      "args": ["gitnexus", "mcp"]
    },
    "synth-logs": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "--directory", "${workspaceFolder}", "python", "mcp_servers/synth_logs.py"]
    }
  }
}