{
  "servers": {
    "gemini-api-docs-mcp": {
      "type": "http",
      "url": "https://gemini-api-docs-mcp.dev"
    },
    "gitnexus": {
      "type": "stdio",
      "command": "npx",
      "args": ["gitnexus", "mcp"]
    },
    "synth-logs": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "python", "mcp_servers/synth_logs.py"]
    },
    "synth-db": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "python", "mcp_servers/synth_db.py"],
      "env": {
        "DB_TYPE": "mariadb",
        "DB_HOST": "192.168.1.13",
        "DB_PORT": "3307",
        "DB_USER": "synth",
        "DB_PASS": "synth",
        "DB_NAME": "synth"
      }
    },
    "synth-cortex": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "python", "mcp_servers/synth_cortex.py"]
    },
    "affine": {
      "type": "stdio",
      "command": "affine-mcp"
    },
    "langfuse": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@therealsachin/langfuse-mcp"],
      "env": {
        "LANGFUSE_PUBLIC_KEY": "pk-lf-9e5f606b-dd83-4002-beb8-354d70f4b1c7",
        "LANGFUSE_SECRET_KEY": "sk-lf-e1296dae-a75f-40ef-abb6-2dd9cb95dfca",
        "LANGFUSE_BASEURL": "https://fuse.zwiz.town"
      }
    }
  }
}